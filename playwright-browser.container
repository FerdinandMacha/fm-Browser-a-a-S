[Container]
Image=ghcr.io/browserless/multi:latest
ContainerName=playwright-browser-service

AddDevice=/dev/dri
SecurityLabelDisable=true
PodmanArgs=--group-add keep-groups --ipc=host
Network=host

Environment=ENABLE_GPU=true
Environment=MAX_CONCURRENT_SESSIONS=10
Environment=XVFB_SCREEN_SIZE=1920x1080x24
Environment=DEFAULT_VIEWPORT_WIDTH=1920
Environment=DEFAULT_VIEWPORT_HEIGHT=1080
Environment=LIBGL_ALWAYS_SOFTWARE=0
Environment=TIMEOUT=120000

PublishPort=3000:3000